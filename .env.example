APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# This app runs on SQL Server as of 2026-09-21. See docs/database-sql-server.md,
# which covers the pdo_sqlsrv build and the five ways SQL Server is stricter than
# the SQLite this used to run on.
DB_CONNECTION=sqlsrv
DB_HOST=127.0.0.1
DB_PORT=1433
DB_DATABASE=NewAttendance
DB_USERNAME=sa
DB_PASSWORD=
DB_ENCRYPT=yes
# Set to true ONLY where the server presents a self-signed certificate: the
# connection stays encrypted but the certificate is not validated. Prefer
# importing the server certificate into the host trust store and leaving this false.
DB_TRUST_SERVER_CERTIFICATE=false

# The pre-2026-09-21 SQLite database, read by the 'sqlite_legacy' connection and by
# `php artisan legacy:sqlite-copy`. Unset on a fresh install.
# SQLITE_LEGACY_DATABASE=/var/www/zkt/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_AUTH_USERNAME=payroll
MQTT_AUTH_PASSWORD=
MQTT_AUTO_RECONNECT_ENABLED=false
MQTT_ATTENDANCE_TOPIC=payroll/attendance/punch

# Overrides the seeded owner password (see DatabaseSeeder). Leave unset to use
# the default committed in the seeder.
OWNER_PASSWORD=
